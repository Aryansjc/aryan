---
const base = import.meta.env.BASE_URL;
---
<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><meta name="color-scheme" content="dark" /><title>404 — aryan singh</title>
<link rel="icon" href={`${base}favicon.ico`} sizes="48x48" />
<link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
<style>:root{--bg:#000;--ink:#e6edf5;--mut:#93a1b3;--acc:#4da3ff;--mono:'Martian Mono',monospace;--disp:'Bricolage Grotesque',sans-serif}*{margin:0}body{background:#000;color:var(--ink);font-family:var(--body,serif);min-height:100vh;display:flex;align-items:center;justify-content:center;text-align:center}h1{font-family:var(--disp,sans-serif);font-size:4rem}a{color:var(--acc);font-family:var(--mono,monospace);font-size:12px}</style>
</head>
<body><div><h1>~/404</h1><p style="color:var(--mut);margin:1em 0 2em">lost in hyperspace?</p><a href={base}>&lt; back to ~/</a></div></body>
</html>

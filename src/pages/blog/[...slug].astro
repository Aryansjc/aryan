---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => import.meta.env.PROD ? data.draft !== true : true);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

type Props = { post: CollectionEntry<'blog'> };
const { post } = Astro.props;
const base = import.meta.env.BASE_URL;
if (!post) return Astro.redirect(`${base}404`);
const { Content, remarkPluginFrontmatter } = await render(post);
const minutesRead = (remarkPluginFrontmatter as any)?.minutesRead as string | undefined;
const fmt = post.data.pubDate.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }).toLowerCase();
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="color-scheme" content="dark" />
<meta name="description" content={post.data.description} />
<link rel="icon" href={`${base}favicon.ico`} sizes="48x48" />
<link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
<title>{post.data.title} — aryan singh</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,800&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=Martian+Mono:wght@400;700&family=Caveat:wght@500;600&display=swap" rel="stylesheet" />
<style is:global>
:root{--bg:#000;--ink:#e6edf5;--mut:#93a1b3;--acc:#4da3ff;--pen:#9cc2ff;--line:rgba(190,215,240,.15);--disp:'Bricolage Grotesque',sans-serif;--body:'Newsreader',serif;--mono:'Martian Mono',monospace;--hand:'Caveat',cursive}
*{margin:0;padding:0;box-sizing:border-box}
html,body{background:#000}
body{color:var(--ink);font-family:var(--body);font-size:16px;min-height:100vh}
::selection{background:var(--acc);color:#000}
a{color:inherit}
.u{text-decoration:underline;text-decoration-color:rgba(190,215,240,.35);text-underline-offset:4px}
.u:hover{color:var(--acc);text-decoration-color:var(--acc);text-decoration-style:wavy}
.top{position:sticky;top:0;z-index:40;display:flex;gap:1.2em;padding:.9em clamp(16px,3vw,36px);background:var(--bg);border-bottom:1px solid var(--line);font-family:var(--mono);font-size:10.5px}
.wrap{max-width:760px;margin:0 auto;padding:clamp(22px,4.5vh,48px) clamp(18px,4.5vw,32px) 80px}
.kicker{font-family:var(--mono);font-size:10px;color:var(--mut);letter-spacing:.08em;margin-bottom:1.2em}
.kicker b{color:var(--acc)}
h1{font-family:var(--disp);font-weight:800;letter-spacing:-.02em;line-height:1.05;font-size:clamp(1.8rem,5vw,2.8rem);margin:.4em 0 .5em;text-transform:lowercase}
.meta{font-family:var(--mono);font-size:10px;color:var(--mut);display:flex;gap:1.4em;flex-wrap:wrap;margin-bottom:.6em}
.meta .bb{color:var(--acc)}
.desc{font-style:italic;color:var(--mut);line-height:1.6;margin-bottom:1em}
.rule{border:none;border-top:1px dashed var(--line);margin:1.5em 0}
.prose p{font-size:1rem;line-height:1.75;color:var(--mut);max-width:52em}
.prose p+p{margin-top:1em}
.prose strong{color:var(--ink);font-weight:500}
.prose a{color:var(--ink);text-decoration:underline;text-decoration-color:rgba(190,215,240,.35);text-underline-offset:4px}
.prose a:hover{color:var(--acc);text-decoration-color:var(--acc);text-decoration-style:wavy}
.prose h2,.prose h3{font-family:var(--disp);color:var(--ink);margin:1.2em 0 .4em}
.prose ul,.prose ol{margin:.6em 0 .6em 1.4em;color:var(--mut);line-height:1.7}
.prose img{max-width:100%;height:auto;display:block;margin:1em 0;border:1px solid var(--line)}
.prose code{font-family:var(--mono);font-size:.82em;background:rgba(190,215,240,.08);padding:.15em .4em;color:var(--ink)}
.prose pre{background:#0d1117;border:1px solid var(--line);padding:1em;overflow-x:auto;margin:1em 0}
.prose pre code{background:none;padding:0}
.tags{margin-top:1.5em;font-family:var(--mono);font-size:9.5px;color:var(--mut)}
.tags i{font-style:normal;color:var(--acc)}
.back{display:inline-block;margin-top:2em;font-family:var(--mono);font-size:10.5px}
</style>
</head>
<body>
<header class="top"><a class="u" href={base}>← home</a><a class="u" href={`${base}#blogs`}>blogs</a><span style="margin-left:auto;color:var(--mut)">aryan singh</span></header>
<main class="wrap">
  <p class="kicker"><b>~/blogs</b> · {post.data.type === 'blog' ? 'blog' : 'log'}</p>
  <div class="meta"><span class={post.data.type === 'blog' ? 'bb' : ''}>{post.data.type === 'blog' ? '● long read' : '● daily win'}</span><span>{fmt}</span>{minutesRead && <span>{minutesRead}</span>}</div>
  <h1>{post.data.title}</h1>
  <p class="desc">{post.data.description}</p>
  <hr class="rule" />
  <div class="prose"><Content /></div>
  <p class="tags">{post.data.tags.map((t) => <><i>#</i>{t}  </>)}</p>
  <a class="u back" href={`${base}#blogs`}>← back to blogs</a>
</main>
</body>
</html>
